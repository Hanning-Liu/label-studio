FROM heartexlabs/label-studio@sha256:aa461572e8f9d86a1bf9520c1db620204e86160fd2f80dd7e9d40ac84a8828ea

LABEL org.opencontainers.image.title="Label Studio Room v3 portals and functional zoning"
LABEL org.opencontainers.image.version="1.23.0-room-v3.3"
LABEL org.opencontainers.image.source.branch="fix/room-v3-room-opacity"

COPY --chown=1001:0 web/dist /label-studio/web/dist
COPY --chown=1001:0 label_studio/tasks/api.py /label-studio/label_studio/tasks/api.py
COPY --chown=1001:0 label_studio/tasks/serializers.py /label-studio/label_studio/tasks/serializers.py
COPY --chown=1001:0 label_studio/core/context_processors.py /label-studio/label_studio/core/context_processors.py
COPY --chown=1001:0 label_studio/templates/base.html /label-studio/label_studio/templates/base.html

USER 1001
