# macos.sh init replaces SOURCE_SHA with the checked-out commit.
HANNING_QA_IMAGE=hanning-label-studio:1.23.2-SOURCE_SHA
HANNING_QA_HOST=http://localhost:18085
HANNING_QA_PORT=18085
# macos.sh supplies this absolute path; spaces are supported.
HANNING_QA_MEDIA=${HANNING_MAC_RUNTIME_DIR}/media
HANNING_QA_DOCUMENT_ROOT=/label-studio/data/local-files
